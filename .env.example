# Cesium Ion credentials for streaming Berlin 3D tiles (used by both
# berlin-flight and _visio-tech-werkschau). Required for the tileset to load;
# without them the experience falls back to an untextured ground plane.
PUBLIC_CESIUM_ION_TOKEN=
PUBLIC_BERLIN_ION_ASSET_ID=
# Optional: bypass the Cesium Ion asset lookup with a direct tileset URL.
PUBLIC_BERLIN_TILES_URL=
PUBLIC_BERLIN_TILES_ATTRIBUTION=

# ICAROS host bridge (gyro/controller input over WebSocket).
PUBLIC_ICAROS_HOST_ORIGIN=
PUBLIC_ICAROS_EXPERIENCE_ID=
PUBLIC_ICAROS_EXPERIENCE_TITLE=
